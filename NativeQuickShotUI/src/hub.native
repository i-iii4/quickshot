<template name="hub-core-fixed">
  <button width="{core_width}" size="sm" variant="secondary" icon="{chevronIcon}" icon-placement="trailing" label="{coreLabel}" on-press="toggle">{coreText}</button>
</template>

<template name="hub-core-auto">
  <button size="sm" variant="secondary" icon="{chevronIcon}" icon-placement="trailing" label="{coreLabel}" on-press="toggle">{coreText}</button>
</template>

<template name="hub-core-foreground-fixed">
  <button width="{core_width}" size="sm" variant="ghost" icon="{chevronIcon}" icon-placement="trailing" label="{coreLabel}" on-press="toggle">{coreText}</button>
</template>

<template name="hub-core-foreground-auto">
  <button size="sm" variant="ghost" icon="{chevronIcon}" icon-placement="trailing" label="{coreLabel}" on-press="toggle">{coreText}</button>
</template>

<row gap="8" cross="center" padding="0" label="QuickShot controls">
  <if test="{hubCoreForegroundSurface}">
    <row padding="6" label="QuickShot core foreground">
      <if test="{coreWidthSet}">
        <use template="hub-core-foreground-fixed" />
      </if>
      <else>
        <use template="hub-core-foreground-auto" />
      </else>
    </row>
  </if>
  <else>
    <if test="{hubCoreBackgroundSurface}">
      <row padding="6" label="QuickShot core surface">
        <button width="{core_width}" size="sm" variant="secondary" label="{coreLabel}" on-press="toggle"></button>
      </row>
    </if>
    <else>
      <if test="{hubBubbleSurface}">
        <panel width="{bubbleWidth}" height="40" background="surface" radius="xl" label="QuickShot hub bubble"></panel>
      </if>
      <else>
        <if test="{thumbnailSurface}">
          <row gap="8" cross="center" label="Screenshot card actions">
            <if test="{compact}">
              <button size="sm" variant="secondary" icon="{copyIcon}" label="{copyLabel}" on-press="copy"></button>
            </if>
            <else>
              <button size="sm" variant="secondary" icon="{copyIcon}" label="{copyLabel}" on-press="copy">{copyText}</button>
            </else>
            <button size="sm" variant="destructive" icon="x" label="Dismiss screenshot" on-press="dismiss"></button>
          </row>
        </if>
        <else>
          <if test="{annotationToolbarSurface}">
            <row gap="8" cross="center" padding="6" label="Annotation toolbar">
              <button-group gap="0" cross="center" label="Annotation tool">
                <button size="sm" selected="{toolSelect}" label="Tool select" on-press="tool_select">Select</button>
                <button size="sm" selected="{toolArrow}" label="Tool arrow" on-press="tool_arrow">Arrow</button>
                <button size="sm" selected="{toolBox}" label="Tool box" on-press="tool_box">Box</button>
                <button size="sm" selected="{toolEllipse}" label="Tool ellipse" on-press="tool_ellipse">Oval</button>
                <button size="sm" selected="{toolLine}" label="Tool line" on-press="tool_line">Line</button>
                <button size="sm" selected="{toolPen}" label="Tool pen" on-press="tool_pen">Pen</button>
                <button size="sm" selected="{toolText}" label="Tool text" on-press="tool_text">Text</button>
                <button size="sm" selected="{toolMark}" label="Tool mark" on-press="tool_mark">Mark</button>
                <button size="sm" selected="{toolStep}" label="Tool step" on-press="tool_step">Step</button>
                <button size="sm" selected="{toolHide}" label="Tool hide" on-press="tool_hide">Hide</button>
                <button size="sm" selected="{toolBlur}" label="Tool blur" on-press="tool_blur">Blur</button>
              </button-group>
              <button-group gap="0" cross="center" label="Colour">
                <button size="sm" selected="{colour0}" label="Colour red" on-press="colour_0">R</button>
                <button size="sm" selected="{colour1}" label="Colour amber" on-press="colour_1">A</button>
                <button size="sm" selected="{colour2}" label="Colour green" on-press="colour_2">G</button>
                <button size="sm" selected="{colour3}" label="Colour blue" on-press="colour_3">B</button>
                <button size="sm" selected="{colour4}" label="Colour violet" on-press="colour_4">V</button>
                <button size="sm" selected="{colour5}" label="Colour graphite" on-press="colour_5">K</button>
              </button-group>
              <button-group gap="0" cross="center" label="Stroke weight">
                <button size="sm" selected="{weightThin}" label="Weight thin" on-press="weight_thin">S</button>
                <button size="sm" selected="{weightMedium}" label="Weight medium" on-press="weight_medium">M</button>
                <button size="sm" selected="{weightThick}" label="Weight thick" on-press="weight_thick">L</button>
              </button-group>
              <button-group gap="0" cross="center" label="Fill">
                <button size="sm" selected="{fillOff}" label="Fill off" on-press="fill_off">Line</button>
                <button size="sm" selected="{fillOn}" label="Fill on" on-press="fill_on">Fill</button>
              </button-group>
              <button size="sm" variant="secondary" icon="refresh-cw" label="Editor undo" on-press="editor_undo"></button>
              <button size="sm" variant="secondary" icon="repeat" label="Editor redo" on-press="editor_redo"></button>
              <button size="sm" variant="secondary" icon="save" label="Editor save" on-press="editor_save">Save</button>
              <button size="sm" variant="secondary" icon="copy" label="Editor copy" on-press="editor_copy"></button>
              <button size="sm" variant="destructive" icon="x" label="Editor close" on-press="editor_close"></button>
            </row>
          </if>
          <else>
            <if test="{settingsSurface}">
              <column gap="10" padding="20" background="background" label="QuickShot settings">
                <text>Thumbnail tray position</text>
                <button-group gap="0" cross="center" label="Tray position">
                  <button size="sm" selected="{positionLeft}" label="Tray left" on-press="position_left">Left</button>
                  <button size="sm" selected="{positionRight}" label="Tray right" on-press="position_right">Right</button>
                  <button size="sm" selected="{positionBottom}" label="Tray bottom" on-press="position_bottom">Bottom</button>
                  <button size="sm" selected="{positionTop}" label="Tray top" on-press="position_top">Top</button>
                </button-group>
                <text size="sm" foreground="text_muted" wrap="true">New screenshots appear at the matching screen corner.</text>
                <text>Save screenshots to disk</text>
                <button-group gap="0" cross="center" label="Autosave">
                  <button size="sm" selected="{autosaveEnabled}" label="Autosave on" on-press="autosave_on">On</button>
                  <button size="sm" selected="{autosaveDisabled}" label="Autosave off" on-press="autosave_off">Off</button>
                </button-group>
                <if test="{autosaveEnabled}">
                  <text>Keep screenshots for</text>
                  <button-group gap="0" cross="center" label="Retention">
                    <button size="sm" selected="{retentionDay}" label="Keep a day" on-press="retention_day">A day</button>
                    <button size="sm" selected="{retentionWeek}" label="Keep a week" on-press="retention_week">A week</button>
                    <button size="sm" selected="{retentionMonth}" label="Keep a month" on-press="retention_month">A month</button>
                    <button size="sm" selected="{retentionForever}" label="Keep forever" on-press="retention_forever">Forever</button>
                  </button-group>
                  <row gap="8" cross="center" label="Folder row">
                    <button size="sm" variant="secondary" icon="folder" label="Open folder" on-press="open_folder">Open Folder</button>
                  </row>
                  <text size="sm" foreground="text_muted" wrap="true">Older screenshots are deleted permanently, not moved to the Trash.</text>
                </if>
                <else>
                  <text size="sm" foreground="text_muted" wrap="true">Screenshots live in the tray and on the clipboard only. Closing the tray removes them.</text>
                </else>
              </column>
            </if>
            <else>
              <if test="{pinnedSurface}">
                <button size="sm" variant="secondary" icon="{copyIcon}" label="{copyLabel}" on-press="copy">{copyText}</button>
              </if>
              <else>
                <row gap="8" cross="center" padding="6" label="QuickShot hub commands">
                  <if test="{actions_after}">
                    <if test="{coreWidthSet}">
                      <use template="hub-core-fixed" />
                    </if>
                    <else>
                      <use template="hub-core-auto" />
                    </else>
                    <if test="{expanded}">
                      <row gap="8" cross="center" label="Screenshot actions">
                        <button size="sm" variant="destructive" icon="x" label="Close" on-press="delete"></button>
                        <button size="sm" variant="secondary" icon="download" label="Save As" on-press="save_as"></button>
                        <button size="sm" variant="secondary" icon="copy" label="Copy All" on-press="copy_all"></button>
                      </row>
                    </if>
                  </if>
                  <else>
                    <if test="{expanded}">
                      <row gap="8" cross="center" label="Screenshot actions">
                        <button size="sm" variant="destructive" icon="x" label="Close" on-press="delete"></button>
                        <button size="sm" variant="secondary" icon="download" label="Save As" on-press="save_as"></button>
                        <button size="sm" variant="secondary" icon="copy" label="Copy All" on-press="copy_all"></button>
                      </row>
                    </if>
                    <if test="{coreWidthSet}">
                      <use template="hub-core-fixed" />
                    </if>
                    <else>
                      <use template="hub-core-auto" />
                    </else>
                  </else>
                </row>
              </else>
            </else>
        </else>
      </else>
    </else>
  </else>
          </else>
</row>
