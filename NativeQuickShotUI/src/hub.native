<row gap="8" cross="center" padding="0" label="QuickShot controls">
        <if test="{thumbnailCopySurface}">
          <row label="Copy screenshot action">
            <if test="{compact}">
              <button size="sm" variant="secondary" icon="{copyIcon}" label="{copyLabel}" on-press="copy"></button>
            </if>
            <else>
              <button size="sm" variant="secondary" icon="{copyIcon}" label="{copyLabel}" on-press="copy">{copyText}</button>
            </else>
          </row>
        </if>
        <else>
        <if test="{thumbnailDismissSurface}">
          <row label="Dismiss screenshot action">
            <button size="sm" variant="destructive" icon="x" label="Dismiss screenshot" on-press="dismiss"></button>
          </row>
        </if>
        <else>
        <if test="{casePanelSurface}">
          <row gap="8" cross="center" padding="6" label="Case actions">
            <button size="sm" variant="destructive" icon="x" label="Close all" on-press="delete"></button>
            <button size="sm" variant="secondary" icon="copy" label="Copy all" on-press="copy_all"></button>
            <button size="sm" variant="secondary" icon="download" label="Save all" on-press="save_as"></button>
            <text size="sm" foreground="text_muted" wrap="false">{countText}</text>
          </row>
        </if>
        <else>
          <if test="{annotationToolbarSurface}">
            <column gap="6" padding="6" label="Annotation toolbar">
              <if test="{toolbarCompact}">
                <row gap="8" cross="center" label="Tools row">
                  <button-group gap="2" cross="center" label="Annotation tool">
                    <button size="sm" selected="{toolSelect}" icon="app:tool-select" label="Select" on-press="tool_select"></button>
                    <button size="sm" selected="{toolArrow}" icon="app:tool-arrow" label="Arrow" on-press="tool_arrow"></button>
                    <button size="sm" selected="{toolBox}" icon="app:tool-box" label="Rectangle" on-press="tool_box"></button>
                    <button size="sm" selected="{toolEllipse}" icon="app:tool-oval" label="Oval" on-press="tool_ellipse"></button>
                    <button size="sm" selected="{toolLine}" icon="app:tool-line" label="Line" on-press="tool_line"></button>
                    <button size="sm" selected="{toolPen}" icon="app:tool-pen" label="Pen" on-press="tool_pen"></button>
                    <button size="sm" selected="{toolText}" icon="app:tool-text" label="Text" on-press="tool_text"></button>
                    <button size="sm" selected="{toolMark}" icon="app:tool-mark" label="Highlight" on-press="tool_mark"></button>
                    <button size="sm" selected="{toolStep}" icon="app:tool-step" label="Step number" on-press="tool_step"></button>
                    <button size="sm" selected="{toolHide}" icon="app:tool-hide" label="Redact" on-press="tool_hide"></button>
                    <button size="sm" selected="{toolCrop}" icon="app:tool-crop" label="Crop" on-press="tool_crop"></button>
                  </button-group>
                </row>
                <if test="{showsStyle}">
                <row gap="8" cross="center" label="Style row">
                  <button-group gap="2" cross="center" label="Colour">
                    <button size="sm" selected="{colour0}" icon="app:swatch-red" label="Red" on-press="colour_0"></button>
                    <button size="sm" selected="{colour1}" icon="app:swatch-amber" label="Amber" on-press="colour_1"></button>
                    <button size="sm" selected="{colour2}" icon="app:swatch-green" label="Green" on-press="colour_2"></button>
                    <button size="sm" selected="{colour3}" icon="app:swatch-blue" label="Blue" on-press="colour_3"></button>
                    <button size="sm" selected="{colour4}" icon="app:swatch-violet" label="Violet" on-press="colour_4"></button>
                    <button size="sm" selected="{colour5}" icon="app:swatch-graphite" label="Graphite" on-press="colour_5"></button>
                  </button-group>
                  <button-group gap="2" cross="center" label="Stroke weight">
                    <button size="sm" selected="{weightThin}" icon="app:weight-thin" label="Thin stroke" on-press="weight_thin"></button>
                    <button size="sm" selected="{weightMedium}" icon="app:weight-medium" label="Medium stroke" on-press="weight_medium"></button>
                    <button size="sm" selected="{weightThick}" icon="app:weight-thick" label="Thick stroke" on-press="weight_thick"></button>
                  </button-group>
                  <button size="sm" variant="ghost" selected="{fillOn}" icon="app:shape-fill" label="Fill shapes" on-press="fill_toggle"></button>
                </row>
                </if>
                <row gap="8" cross="center" label="Command row">
                  <button size="sm" variant="ghost" icon="app:undo" label="Undo" disabled="{cannotUndo}" on-press="editor_undo"></button>
                  <button size="sm" variant="ghost" icon="app:redo" label="Redo" disabled="{cannotRedo}" on-press="editor_redo"></button>
                  <button size="sm" variant="ghost" icon="app:scan" label="Find private data" on-press="editor_scan"></button>
                  <if test="{showsTransform}">
                    <button size="sm" variant="ghost" icon="refresh-cw" label="Rotate" on-press="editor_rotate"></button>
                  </if>
                  <spacer grow="1"/>
                  <button size="sm" variant="secondary" icon="save" label="Save" on-press="editor_save"></button>
                  <button size="sm" variant="secondary" icon="copy" label="Copy" on-press="editor_copy"></button>
                </row>
              </if>
              <else>
                <row gap="8" cross="center" label="Toolbar row">
                  <button-group gap="2" cross="center" label="Annotation tool">
                    <button size="sm" selected="{toolSelect}" icon="app:tool-select" label="Select" on-press="tool_select"></button>
                    <button size="sm" selected="{toolArrow}" icon="app:tool-arrow" label="Arrow" on-press="tool_arrow"></button>
                    <button size="sm" selected="{toolBox}" icon="app:tool-box" label="Rectangle" on-press="tool_box"></button>
                    <button size="sm" selected="{toolEllipse}" icon="app:tool-oval" label="Oval" on-press="tool_ellipse"></button>
                    <button size="sm" selected="{toolLine}" icon="app:tool-line" label="Line" on-press="tool_line"></button>
                    <button size="sm" selected="{toolPen}" icon="app:tool-pen" label="Pen" on-press="tool_pen"></button>
                    <button size="sm" selected="{toolText}" icon="app:tool-text" label="Text" on-press="tool_text"></button>
                    <button size="sm" selected="{toolMark}" icon="app:tool-mark" label="Highlight" on-press="tool_mark"></button>
                    <button size="sm" selected="{toolStep}" icon="app:tool-step" label="Step number" on-press="tool_step"></button>
                    <button size="sm" selected="{toolHide}" icon="app:tool-hide" label="Redact" on-press="tool_hide"></button>
                    <button size="sm" selected="{toolCrop}" icon="app:tool-crop" label="Crop" on-press="tool_crop"></button>
                  </button-group>
                  <if test="{showsStyle}">
                  <button-group gap="2" cross="center" label="Colour">
                    <button size="sm" selected="{colour0}" icon="app:swatch-red" label="Red" on-press="colour_0"></button>
                    <button size="sm" selected="{colour1}" icon="app:swatch-amber" label="Amber" on-press="colour_1"></button>
                    <button size="sm" selected="{colour2}" icon="app:swatch-green" label="Green" on-press="colour_2"></button>
                    <button size="sm" selected="{colour3}" icon="app:swatch-blue" label="Blue" on-press="colour_3"></button>
                    <button size="sm" selected="{colour4}" icon="app:swatch-violet" label="Violet" on-press="colour_4"></button>
                    <button size="sm" selected="{colour5}" icon="app:swatch-graphite" label="Graphite" on-press="colour_5"></button>
                  </button-group>
                  <button-group gap="2" cross="center" label="Stroke weight">
                    <button size="sm" selected="{weightThin}" icon="app:weight-thin" label="Thin stroke" on-press="weight_thin"></button>
                    <button size="sm" selected="{weightMedium}" icon="app:weight-medium" label="Medium stroke" on-press="weight_medium"></button>
                    <button size="sm" selected="{weightThick}" icon="app:weight-thick" label="Thick stroke" on-press="weight_thick"></button>
                  </button-group>
                  <button size="sm" variant="ghost" selected="{fillOn}" icon="app:shape-fill" label="Fill shapes" on-press="fill_toggle"></button>
                  </if>
                  <button size="sm" variant="ghost" icon="app:undo" label="Undo" disabled="{cannotUndo}" on-press="editor_undo"></button>
                  <button size="sm" variant="ghost" icon="app:redo" label="Redo" disabled="{cannotRedo}" on-press="editor_redo"></button>
                  <button size="sm" variant="ghost" icon="app:scan" label="Find private data" on-press="editor_scan"></button>
                  <if test="{showsTransform}">
                    <button size="sm" variant="ghost" icon="refresh-cw" label="Rotate" on-press="editor_rotate"></button>
                  </if>
                  <spacer grow="1"/>
                  <button size="sm" variant="secondary" icon="save" label="Save" on-press="editor_save"></button>
                  <button size="sm" variant="secondary" icon="copy" label="Copy" on-press="editor_copy"></button>
                </row>
              </else>
            </column>
          </if>
          <else>
            <if test="{settingsSurface}">
              <column gap="10" padding="20" background="background" label="QuickShot settings">
                <text>Thumbnail tray position</text>
                <button-group gap="0" cross="center" label="Tray position">
                  <button size="sm" selected="{positionBottomLeft}" label="Tray bottom left" on-press="position_bottom_left">Bottom Left</button>
                  <button size="sm" selected="{positionBottomRight}" label="Tray bottom right" on-press="position_bottom_right">Bottom Right</button>
                  <button size="sm" selected="{positionTopLeft}" label="Tray top left" on-press="position_top_left">Top Left</button>
                  <button size="sm" selected="{positionTopRight}" label="Tray top right" on-press="position_top_right">Top Right</button>
                </button-group>
                <text size="sm" foreground="text_muted" wrap="true">New screenshots appear at the matching screen corner.</text>
                <text>Save screenshots to disk</text>
                <button-group gap="0" cross="center" label="Autosave">
                  <button size="sm" selected="{autosaveEnabled}" label="Autosave on" on-press="autosave_on">Save</button>
                  <button size="sm" selected="{autosaveDisabled}" label="Autosave off" on-press="autosave_off">Don't save</button>
                </button-group>
                <if test="{autosaveEnabled}">
                  <text>Keep screenshots for</text>
                  <button-group gap="0" cross="center" label="Retention">
                    <button size="sm" selected="{retentionDay}" label="Keep a day" on-press="retention_day">A day</button>
                    <button size="sm" selected="{retentionWeek}" label="Keep a week" on-press="retention_week">A week</button>
                    <button size="sm" selected="{retentionMonth}" label="Keep a month" on-press="retention_month">A month</button>
                    <button size="sm" selected="{retentionForever}" label="Keep forever" on-press="retention_forever">Forever</button>
                  </button-group>
                  <row gap="8" cross="center" label="Folder row">
                    <button size="sm" variant="secondary" icon="folder" label="Open folder" on-press="open_folder">Open Folder</button>
                  </row>
                  <text size="sm" foreground="text_muted" wrap="true">Older screenshots are deleted permanently, not moved to the Trash.</text>
                </if>
                <else>
                  <text size="sm" foreground="text_muted" wrap="true">Screenshots live in the tray and on the clipboard only. Closing the tray removes them.</text>
                </else>
              </column>
            </if>
            <else>
              <if test="{pinnedSurface}">
                <button size="sm" variant="secondary" icon="{copyIcon}" label="{copyLabel}" on-press="copy">{copyText}</button>
              </if>
  </else>
  </else>
  </else>
  </else>
  </else>
</row>
